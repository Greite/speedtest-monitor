{
  "name": "speedtest-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=24.0.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "puppeteer",
    "esbuild",
    "sharp",
    "@biomejs/biome"
  ],
  "scripts": {
    "dev": "bun server.ts",
    "build": "bunx drizzle-kit generate && bun scripts/fetch-releases.ts && bun scripts/build-email-templates.ts && next build",
    "build:email": "bun scripts/build-email-templates.ts",
    "releases:fetch": "bun scripts/fetch-releases.ts",
    "start": "NODE_ENV=production bun server.ts",
    "prelint": "next typegen",
    "lint": "bun tsc && bun biome:check && bun biome:format",
    "tsc": "tsc --noEmit --pretty",
    "biome:check": "biome check .",
    "biome:check:write": "biome check --write .",
    "biome:format:write": "biome format --write .",
    "biome:format": "biome format .",
    "biome:write": "biome check --write . && biome format --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:a11y": "bunx @axe-core/cli http://localhost:3003 --tags wcag2a,wcag2aa,wcag21a,wcag21aa",
    "test:a11y:page": "bun scripts/axe-audit.ts http://localhost:3003/login",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "theme:build": "bun scripts/theme-build.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.7",
    "@astryxdesign/theme-neutral": "0.1.7",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.11",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.7",
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/mjml": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "axe-core": "4.12.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lucide-react": "^1.25.0",
    "mjml": "^5.4.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.19",
    "puppeteer-core": "25.3.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
